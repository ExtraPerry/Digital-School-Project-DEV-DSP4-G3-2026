# Public (safe to expose in the browser)
# Also read at build time by next.config.ts to allow-list the Storage origin for
# next/image, and by `npm run seed:media` to choose the target project.
# Local: http://127.0.0.1:54321 — hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — also used by `npm run seed:media` to write boat_media rows.
NEXT_PRIVATE_SUPABASE_ADMIN_KEY=your-service-role-key

# Stripe (test mode) — also set in supabase/functions/.env for edge functions
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
SITE_URL=http://localhost:3000
