# Edge function secrets for local `supabase functions serve`.
# Do NOT put SUPABASE_* here — the CLI injects those automatically
# (names starting with SUPABASE_ are skipped from --env-file).

SITE_URL=http://localhost:3000

# Stripe Dashboard → Developers → API keys (Test mode)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# From `stripe listen --forward-to http://127.0.0.1:54321/functions/v1/stripe-webhook`
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
